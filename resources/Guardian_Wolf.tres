passive_name = "Root Network"
passive_description = "+Passive Ability | Persistent\\nDeep roots tap into the battlefield ecosystem. Generates +6.0 base resonance per pulse. Grants a Pack Bonus of +0.5 energy for every adjacent Wolf cell, capped at a maximum of +9.0 regeneration."
