active_description = "+Active Ability | Cost: 15 Energy\\nFortifies the cell perimeter with defensive vines for 3 pulses, reducing all incoming resonance damage by 50%. Max 3 deployments per round."
active_icon = ExtResource("1_h78xe")
active_icon_scale = Vector2(0.25, 0.24)
ulti_name = "Call of the Pack"
ulti_description = "+Ultimate Ability | Cost: 50 Energy\\nUnleashes a cascading 3-ring sonic shockwave. Injects +33, +22, and +11 Wolf resonance into expanding rings, forcing instant territorial conversion. Max 1 deployment per round."
